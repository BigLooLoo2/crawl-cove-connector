{
    "name": "crawlcove/crawl-cove-connector",
    "description": "WordPress companion plugin for the Crawl Cove desktop SEO crawler.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcsstandards/phpcsutils": "^1.2",
        "phpcsstandards/phpcsextra": "^1.5"
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "lint": "find . -path ./vendor -prune -o -path './tests/integration/.site' -prune -o -path './tests/integration/.cache' -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
        "phpcs": "phpcs"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
